{
	"name": "neon-radio",
	"version": "1.0.0",
	"private": true,
	"license": "ISC",
	"author": "heyCHEEMS",
	"engines": {
		"node": ">=20.12.0"
	},
	"packageManager": "pnpm@12.6.0",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"start": "pnpm build && node scripts/start.mjs",
		"build": "pnpm --dir frontend build",
		"typecheck": "pnpm --dir server typecheck && pnpm --dir frontend typecheck",
		"clean": "node scripts/clean.mjs",
		"stop": "pm2 stop neon-radio-api neon-radio-web",
		"log": "pm2 logs"
	},
	"dependencies": {
		"pm2": "^7.1.2"
	},
	"devDependencies": {
		"concurrently": "^10.0.7",
		"tsx": "^4.23.15"
	}
}