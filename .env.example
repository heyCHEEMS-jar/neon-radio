# 站点域名，必须以“/”结尾
SITE_URL=

# 站点名称，留空则用 Neon Radio
SITE_NAME=

# 站点描述
SITE_DESCRIPTION=

# 应用访问端口
WEB_PORT=3003

# API 内部服务端口
API_PORT=4003

# 数据库主机名
DB_HOST=localhost

# 数据库端口
DB_PORT=3306

# 数据库用户名
DB_USER=root

# 数据库密码
DB_PASSWORD=

# 数据库名称
DB_NAME=neon-radio

# 用户登录有效期，单位天，默认30天
USER_SESSION_DAYS=30

# 包管理器 (默认pnpm, 可选: pnpm | npm | yarn)
PACKAGE_TOOL=pnpm

# =======================================
# NeteaseCloudMusicApi
# =======================================

# 网易云音乐账号 uid
NETEASE_UID=

# 网易云音乐 Cookie 加密密钥，必须是标准的 Base64 编码 32 字节随机值
# 可用 node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))" 生成
NETEASE_COOKIE_ENCRYPTION_KEY=

# Cookie 定时刷新间隔，默认每6小时刷新
COOKIE_REFRESH_HOURS=6

### CORS资源共享设置
## 如果你需要配置, 请取消下面的注释并设置具体的域名
# CORS_ALLOW_ORIGIN = "*"

### 代理设置
## 启用反向代理
ENABLE_PROXY=false

## 代理配置
PROXY_URL="https://your-proxy-url.com/?proxy="

### 随机IP设置
## 启用随机中国IP（默认关闭）；启用后，所有请求默认使用随机中国IP，除非请求参数randomCNIP显式关闭
ENABLE_RANDOM_CN_IP=false

### UnblockNeteaseMusic 设置项
## 启用全局解灰, 无论是否调用参数都会使用解灰(不推荐开启)
ENABLE_GENERAL_UNBLOCK=false

## 歌曲启用无损音质
ENABLE_FLAC=true

## 启用无损音质时，是否选择音质最高的
SELECT_MAX_BR=true

## 严格按照配置音源设置顺序进行匹配
FOLLOW_SOURCE_ORDER=true
